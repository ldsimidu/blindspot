# simulated | claude | openrouter
LLM_PROVIDER=simulated

# Required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Modelo roteado pelo OpenRouter (ex.: Gemini 2.5 Flash).
# Impacto: muda custo/qualidade/latencia do provider openrouter.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Maximo de tokens de saida do OpenRouter.
# Impacto: maior reduz truncamento, mas aumenta custo.
OPENROUTER_MAX_TOKENS=5000

# Maximo de turnos para corrigir JSON invalido/sem busca.
# Impacto: maior aumenta robustez e custo.
OPENROUTER_MAX_TURNS=2

# Habilita refine adicional com base em cobertura pendente.
# Impacto: geralmente aumenta cobertura com custo moderado.
OPENROUTER_REFINE_ENABLED=true

# Metas de cobertura/pendencia para decidir se precisa refinar.
OPENROUTER_COVERAGE_TARGET=0.70
OPENROUTER_UNRESOLVED_TARGET=60
OPENROUTER_UNRESOLVED_LIST_LIMIT=50

# Exige uso de web search no OpenRouter.
# Impacto: reduz resposta por memoria e melhora rastreabilidade.
OPENROUTER_REQUIRE_WEB_SEARCH=true

# Limita o total de resultados web entregues ao modelo.
# Impacto: ajuda a controlar custo e ruido de contexto.
OPENROUTER_WEB_SEARCH_MAX_USES=2
OPENROUTER_WEB_SEARCH_MAX_RESULTS=5
OPENROUTER_WEB_SEARCH_MAX_TOTAL_RESULTS=10

# Budget quick (primeira passada economica).
# Impacto: controla custo inicial antes do refine orientado por lacunas.
OPENROUTER_QUICK_MAX_TOKENS=3200
OPENROUTER_QUICK_MAX_TURNS=1
OPENROUTER_QUICK_WEB_SEARCH_MAX_USES=1
OPENROUTER_QUICK_WEB_SEARCH_MAX_RESULTS=3
OPENROUTER_QUICK_WEB_SEARCH_MAX_TOTAL_RESULTS=3

# Protecao anti-loop exclusiva para OpenRouter + Gemini.
# Impacto: evita loop de tool_calls sem JSON final; nao afeta fluxo Claude.
OPENROUTER_GEMINI_TOOL_LOOP_GUARD_ENABLED=true

# Engine opcional para web search (exa | firecrawl | native | parallel).
# Impacto: altera comportamento/fonte da busca dependendo da conta.
OPENROUTER_WEB_SEARCH_ENGINE=

# Tamanho do contexto retornado pela busca (low | medium | high).
# Impacto: low gasta menos tokens; high traz mais evidencias.
OPENROUTER_WEB_SEARCH_CONTEXT_SIZE=medium

# Exige validacao das URLs finais no payload (HEAD/GET probe).
# Impacto: evita fontes inventadas; pode falhar em sites instaveis.
OPENROUTER_ENFORCE_REAL_SOURCES=true

# Exige que fonte final tenha sido observada na resposta bruta do modelo.
# Impacto: aumenta rigor de auditoria; pode reduzir cobertura.
OPENROUTER_REQUIRE_OBSERVED_SOURCE_MATCH=false

# Timeout de validacao de URL de fonte (ms).
OPENROUTER_SOURCE_PROBE_TIMEOUT_MS=8000

# Forca resposta em formato JSON object (OpenAI-compatible).
# Impacto: reduz risco de markdown/texto fora do schema.
OPENROUTER_USE_JSON_RESPONSE_FORMAT=true

# Roteador de passes para OpenRouter (quick -> refine -> conflict, quando necessario).
OPENROUTER_ROUTER_ENABLED=true
OPENROUTER_ROUTER_MIN_COVERAGE=0.70
OPENROUTER_ROUTER_MAX_UNRESOLVED=60
OPENROUTER_ROUTER_MAX_NAO_ENCONTRADAS=60
OPENROUTER_ROUTER_MAX_CONFLITANTES=1
OPENROUTER_ROUTER_MAX_REFINE_PASSES=1
OPENROUTER_ROUTER_MAX_CONFLICT_PASSES=0
OPENROUTER_ROUTER_UNRESOLVED_LIST_LIMIT=50

# Dominios permitidos/bloqueados no web search OpenRouter (CSV).
# Regra: use apenas um dos dois.
OPENROUTER_ALLOWED_DOMAINS=ford.com.br,fordservicecontent.com,www.guia360ford.com.br
OPENROUTER_BLOCKED_DOMAINS=

# Metadados opcionais para observabilidade no OpenRouter.
OPENROUTER_APP_TITLE=BlindSpot
OPENROUTER_HTTP_REFERER=http://localhost:5173

# Modelo Claude usado na chamada principal da API.
# Impacto: muda qualidade/custo/latencia geral da geracao.
CLAUDE_MODEL=claude-sonnet-4-5
# claude-sonnet-4-5
# claude-haiku-4-5

# Tipo/familia da ferramenta de web search do Claude.
# Impacto: determina o backend de busca disponivel para o modelo.
CLAUDE_WEB_SEARCH_TOOL_TYPE=web_search_20250305

# Maximo de tokens de saida por passe (quick/refine/conflict).
# Impacto: mais alto reduz truncamento, mas aumenta custo.
CLAUDE_MAX_TOKENS=12000

# Maximo de buscas web por request do passe atual.
# Impacto: mais alto melhora cobertura, mas aumenta custo/tempo.
CLAUDE_WEB_SEARCH_MAX_USES=2

# Maximo de turnos por passe (quantas idas e voltas com tool_use).
# Impacto: mais turnos aumentam chance de fechar JSON valido.
CLAUDE_MAX_TURNS=2

# Forca uso de web search (tool_choice=any) no Claude.
# Impacto: evita resposta por memoria, mas pode gastar mais.
CLAUDE_REQUIRE_WEB_SEARCH=true

# Exige validacao de fontes reais no payload final.
# Impacto: reduz URL inventada, pode rejeitar respostas incompletas.
CLAUDE_ENFORCE_REAL_SOURCES=true

# Exige que fonte final tambem tenha sido observada nos resultados da busca.
# Impacto: aumenta rigor; pode derrubar cobertura se muito restritivo.
CLAUDE_REQUIRE_OBSERVED_SOURCE_MATCH=false

# Timeout da validacao de URL de fonte (HEAD/GET) em ms.
# Impacto: maior tolera sites lentos; menor falha mais rapido.
CLAUDE_SOURCE_PROBE_TIMEOUT_MS=8000

# Habilita passe de refinamento quando ha lacunas de cobertura.
# Impacto: costuma aumentar preenchimento com custo adicional.
CLAUDE_REFINE_ENABLED=true

# Meta de cobertura minima para considerar resposta aceitavel.
# Impacto: alvo mais alto induz mais refinamento e mais custo.
CLAUDE_COVERAGE_TARGET=0.70

# Tolerancia total de pendencias (unresolved) antes de refinar.
# Impacto: valor alto aceita mais faltas e encerra mais cedo.
CLAUDE_UNRESOLVED_TARGET=60

# Limite de variaveis pendentes listadas no prompt de refine.
# Impacto: controla tamanho do follow-up e foco da iteracao.
CLAUDE_UNRESOLVED_LIST_LIMIT=50

# Orcamento de tokens do passe quick.
# Impacto: define profundidade da primeira coleta (mais alto = mais cobertura/custo).
CLAUDE_QUICK_MAX_TOKENS=10000

# Maximo de buscas web apenas no passe quick.
# Impacto: controla agressividade de coleta inicial.
CLAUDE_QUICK_WEB_SEARCH_MAX_USES=2

# Maximo de turnos apenas no passe quick.
# Impacto: turnos baixos podem cortar coleta cedo; turnos altos aumentam robustez.
CLAUDE_QUICK_MAX_TURNS=2

# Habilita o roteador interno de decisao de passes.
# Impacto: decide automaticamente se para, refina ou resolve conflitos.
CLAUDE_ROUTER_ENABLED=true

# Cobertura minima exigida pelo router para encerrar.
# Impacto: se nao bater, tende a acionar refine.
CLAUDE_ROUTER_MIN_COVERAGE=0.70

# Maximo de pendencias totais aceitas pelo router.
# Impacto: acima disso o router tenta nova iteracao.
CLAUDE_ROUTER_MAX_UNRESOLVED=60

# Maximo de itens com status nao_encontrado aceitos pelo router.
# Impacto: controla quanto "NF1" pode passar sem novo passe.
CLAUDE_ROUTER_MAX_NAO_ENCONTRADAS=60

# Maximo de itens conflitantes aceitos pelo router.
# Impacto: conflitos acima disso podem acionar conflict_resolver.
CLAUDE_ROUTER_MAX_CONFLITANTES=2

# Numero maximo de passes de refine permitidos pelo router.
# Impacto: limita custo e latencia de tentativas extras.
CLAUDE_ROUTER_MAX_REFINE_PASSES=1

# Numero maximo de passes de resolucao de conflito.
# Impacto: ativa/desativa tratamento automatico de conflitos.
CLAUDE_ROUTER_MAX_CONFLICT_PASSES=0

# Tamanho maximo do texto do assistente reaproveitado no follow-up.
# Impacto: menor reduz tokens; pode perder contexto util.
CLAUDE_FOLLOWUP_MAX_TEXT_CHARS=2200

# Limite de variaveis pendentes que o router injeta no prompt de refine.
# Impacto: define foco da lista de unresolved durante roteamento.
CLAUDE_ROUTER_UNRESOLVED_LIST_LIMIT=50

# Dominios permitidos para busca web (lista CSV).
# Impacto: aumenta confiabilidade, mas pode reduzir cobertura fora da whitelist.
CLAUDE_ALLOWED_DOMAINS=ford.com.br,fordservicecontent.com,www.guia360ford.com.br

# Dominios bloqueados para busca web (lista CSV).
# Impacto: use quando quiser excluir fontes; nao use junto com ALLOWED.
CLAUDE_BLOCKED_DOMAINS=

# Header beta opcional da API Anthropic para recursos experimentais.
# Impacto: pode destravar features especificas da conta.
# Example: web-search-2025-03-05
CLAUDE_BETA_HEADER=

# Se true, quando Claude falhar usa mock-response.json como fallback.
# Impacto: evita erro no front, mas mascara falha real da LLM.
LLM_FALLBACK_TO_MOCK=false
