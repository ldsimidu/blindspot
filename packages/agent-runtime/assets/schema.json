    "veiculo_alvo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marca",
        "modelo",
        "versao",
        "ano_modelo",
        "mercado"
      ],
      "properties": {
        "marca": {
          "type": "string",
          "minLength": 1
        },
        "modelo": {
          "type": "string",
          "minLength": 1
        },
        "versao": {
          "type": "string",
          "minLength": 1
        },
        "ano_modelo": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "mercado": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadados_coleta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fonte_primaria",
        "data_referencia",
        "status_preenchimento",
        "observacoes_gerais",
        "observacoes_padrao"
      ],
      "properties": {
        "fonte_primaria": {
          "type": "string",
          "minLength": 1
        },
        "data_referencia": {
          "type": "string",
          "format": "date"
        },
        "status_preenchimento": {
          "type": "string",
          "enum": [
            "completo",
            "parcial",
            "pendente"
          ]
        },
        "observacoes_gerais": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observacoes_padrao": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "NF1",
            "NA1",
            "CF1"
          ],
          "properties": {
            "NF1": {
              "type": "string",
              "const": "nao_localizado_com_evidencia_confiavel_nas_fontes_oficiais_consultadas_para_o_mercado_e_ano_modelo"
            },
            "NA1": {
              "type": "string",
              "const": "item_nao_se_aplica_a_configuracao_do_veiculo"
            },
            "CF1": {
              "type": "string",
              "const": "divergencia_entre_fontes_relevantes_sem_desempate_oficial_conclusivo"
            }
          }
        }
      }
    },
    "fontes_utilizadas": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/fonte"
      }
    },
