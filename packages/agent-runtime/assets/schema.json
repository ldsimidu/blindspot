  "$defs": {
    "fonte_id": {
      "type": "string",
      "pattern": "^F[0-9]+$"
    },
    "fonte_ref": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fonte_id"
      }
    },
    "fonte_ref_conflito": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fonte_id"
      }
    },
    "obs_ref": {
      "type": "string",
      "enum": [
        "NF1",
        "NA1",
        "CF1"
      ]
    },
    "fonte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "titulo",
        "tipo"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/fonte_id"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "titulo": {
          "type": "string",
          "minLength": 1
        },
        "tipo": {
          "type": "string",
          "minLength": 1
        },
        "avaliacao_politica": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "versao"
          ],
          "properties": {
            "status": {
              "enum": [
                "na_lista_aprovada",
                "fora_da_lista_aprovada",
                "nao_rastreavel_com_seguranca",
                "sem_politica_para_mercado",
                "fonte_simulada_local"
              ]
            },
            "versao": {
              "type": "string",
              "minLength": 1
            },
            "motivos": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "avaliacao_aderencia": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "criterios",
            "motivos",
            "versao"
          ],
          "properties": {
            "status": {
              "enum": [
                "exata",
                "compativel",
                "ambigua",
                "divergente",
                "nao_verificada"
              ]
            },
            "criterios": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "marca_modelo",
                "versao_motorizacao",
                "ano_modelo",
                "mercado"
              ],
              "properties": {
                "marca_modelo": { "$ref": "#/$defs/criterio_aderencia" },
                "versao_motorizacao": { "$ref": "#/$defs/criterio_aderencia" },
                "ano_modelo": { "$ref": "#/$defs/criterio_aderencia" },
                "mercado": { "$ref": "#/$defs/criterio_aderencia" }
              }
            },
            "motivos": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "versao": { "type": "string", "minLength": 1 },
            "avaliada_em": { "type": "string", "format": "date-time" }
          }
        },
        "evidencia_busca": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observada"],
          "properties": {
            "observada": { "type": "boolean" },
            "titulo_observado": { "type": "string", "minLength": 1, "maxLength": 300 },
            "observada_em": { "type": "string", "format": "date-time" },
            "conteudo_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "provider": { "enum": ["openrouter", "claude"] },
            "modelo": { "type": "string", "minLength": 1 },
            "passe": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": { "properties": { "observada": { "const": true } }, "required": ["observada"] },
              "then": { "required": ["titulo_observado", "observada_em", "conteudo_sha256", "provider", "modelo", "passe"] }
            }
          ]
        }
      }
    },
    "criterio_aderencia": {
      "type": "string",
      "enum": ["compativel", "divergente", "nao_verificado"]
    },
    "valor_base": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      ]
    },
    "campo_confirmado": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valor",
        "status",
        "fonte_ref"
      ],
      "properties": {
        "valor": {
          "$ref": "#/$defs/valor_base"
        },
        "valor_original": {
          "$ref": "#/$defs/valor_base"
        },
        "status": {
          "const": "confirmado"
        },
        "fonte_ref": {
          "$ref": "#/$defs/fonte_ref"
        }
      }
    },
    "campo_parcial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valor",
        "status",
        "fonte_ref"
      ],
      "properties": {
        "valor": {
          "$ref": "#/$defs/valor_base"
        },
        "valor_original": {
          "$ref": "#/$defs/valor_base"
        },
        "status": {
          "const": "parcial"
        },
        "fonte_ref": {
          "$ref": "#/$defs/fonte_ref"
        },
        "obs_ref": {
          "$ref": "#/$defs/obs_ref"
        },
        "observacoes": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "obs_ref"
          ]
        },
        {
          "required": [
            "observacoes"
          ]
        }
      ]
    },
    "campo_conflitante": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valor",
        "status",
        "fonte_ref"
      ],
      "properties": {
        "valor": {
          "type": "null"
        },
        "status": {
          "const": "conflitante"
        },
        "fonte_ref": {
          "$ref": "#/$defs/fonte_ref_conflito"
        },
        "obs_ref": {
          "$ref": "#/$defs/obs_ref"
        },
        "observacoes": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "obs_ref"
          ]
        },
        {
          "required": [
            "observacoes"
          ]
        }
      ]
    },
    "campo_nao_encontrado": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valor",
        "status",
        "obs_ref"
      ],
      "properties": {
        "valor": {
          "type": "null"
        },
        "status": {
          "const": "nao_encontrado"
        },
        "obs_ref": {
          "const": "NF1"
        }
      }
    },
    "campo_nao_aplicavel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valor",
        "status"
      ],
      "properties": {
        "valor": {
          "type": "null"
        },
        "status": {
          "const": "nao_aplicavel"
        }
      }
    },
    "campo_inferido_minimamente": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valor",
        "status",
        "fonte_ref"
      ],
      "properties": {
        "valor": {
          "$ref": "#/$defs/valor_base"
        },
        "valor_original": {
          "$ref": "#/$defs/valor_base"
        },
        "status": {
          "const": "inferido_minimamente"
        },
        "fonte_ref": {
          "$ref": "#/$defs/fonte_ref"
        },
        "obs_ref": {
          "$ref": "#/$defs/obs_ref"
        },
        "observacoes": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "obs_ref"
          ]
        },
        {
          "required": [
            "observacoes"
          ]
        }
      ]
    },
    "campo_informado_na_entrada": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valor",
        "status",
        "origem"
      ],
      "properties": {
        "valor": {
          "$ref": "#/$defs/valor_base"
        },
        "status": {
          "const": "informado_na_entrada"
        },
        "origem": {
          "const": "entrada_usuario"
        }
      }
    },
    "campo_status": {
      "oneOf": [
        {
          "$ref": "#/$defs/campo_confirmado"
        },
        {
          "$ref": "#/$defs/campo_parcial"
        },
        {
          "$ref": "#/$defs/campo_conflitante"
        },
        {
          "$ref": "#/$defs/campo_nao_encontrado"
        },
        {
          "$ref": "#/$defs/campo_nao_aplicavel"
        },
        {
          "$ref": "#/$defs/campo_inferido_minimamente"
        },
        {
          "$ref": "#/$defs/campo_informado_na_entrada"
        }
      ]
    },
    "item_adicional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nome",
        "detalhe"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "detalhe": {
          "$ref": "#/$defs/campo_status"
        }
      }
    }
  }
}
