{
  "name": "blindspot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --config vite.config.ts",
    "dev:api": "node --use-system-ca --import tsx --watch services/api/index.ts",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "verify:source-policy": "tsx scripts/verify-source-policy.ts",
    "verify:source-evidence": "tsx scripts/verify-source-evidence.ts",
    "verify:research-capabilities": "tsx scripts/verify-research-capabilities.ts",
    "verify:document-reader": "tsx scripts/verify-document-reader.ts",
    "verify:telemetry-sanitization": "tsx scripts/verify-telemetry-sanitization.ts",
    "verify:normalization": "tsx scripts/verify-normalization.ts",
    "verify:technical-sheet-catalog": "tsx scripts/verify-technical-sheet-catalog.ts",
    "verify:field-policy": "tsx scripts/verify-field-policy.ts",
    "verify:technical-search-facets": "tsx scripts/verify-technical-search-facets.ts",
    "verify:quality-policy": "tsx scripts/verify-quality-policy.ts",
    "verify:catalog-contract": "tsx scripts/verify-catalog-contract.ts",
    "verify:technical-sheet-lineage": "tsx scripts/verify-technical-sheet-lineage.ts",
    "verify:technical-sheet-lineage-db": "node --use-system-ca --import tsx scripts/verify-technical-sheet-lineage-db.ts",
    "verify:technical-sheet-concurrency-db": "node --use-system-ca --import tsx scripts/verify-technical-sheet-concurrency-db.ts",
    "verify:research-sessions": "tsx scripts/verify-research-sessions.ts",
    "verify:research-plan": "tsx scripts/verify-research-plan.ts",
    "verify:research-session-quality-impact": "tsx scripts/verify-research-session-quality-impact.ts",
    "verify:research-session-history": "tsx scripts/verify-research-session-history.ts",
    "verify:research-session-execution-db": "node --use-system-ca --import tsx scripts/verify-research-session-execution-db.ts",
    "verify:research-acceptance-contract": "tsx scripts/verify-research-acceptance-contract.ts",
    "verify:research-acceptance-db": "node --use-system-ca --import tsx scripts/verify-research-acceptance-db.ts",
    "verify:inactive-default-sheet-recovery-db": "node --use-system-ca --import tsx scripts/verify-inactive-default-sheet-recovery-db.ts",
    "verify:research-acceptance": "npm run verify:research-acceptance-contract && npm run verify:field-states && npm run verify:research-plan && npm run verify:research-session-history && npm run verify:workspace-contract-db && npm run verify:technical-sheet-lineage-db && npm run verify:technical-sheet-governance-db && npm run verify:research-session-execution-db && npm run verify:research-acceptance-db",
    "verify:quality-vector": "tsx scripts/verify-quality-vector.ts",
    "verify:field-states": "tsx scripts/verify-field-states.ts",
    "verify:technical-sheet-governance-db": "node --use-system-ca --import tsx scripts/verify-technical-sheet-governance-db.ts",
    "verify:workspace-contract": "tsx scripts/verify-workspace-contract.ts",
    "verify:workspace-contract-db": "node --use-system-ca --import tsx scripts/verify-workspace-contract-db.ts",
    "verify:cnpj": "tsx scripts/verify-cnpj-validation.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --use-system-ca ./node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "4.22.2",
    "pdf-parse": "2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "qs": "6.16.0"
  }
}
